{
  "description": "Cases for the issue predicate. Both `is_issue` in crates/premier-cli/src/issues.rs and `isIssue` in apps/viewer/src/lib/analysis.ts must agree with every `issue` value here.",
  "cases": [
    { "name": "error status", "kind": "tool.result", "status": "error", "payload": {}, "issue": true },
    { "name": "failed status", "kind": "tool.result", "status": "failed", "payload": {}, "issue": true },
    { "name": "denied status, any case", "kind": "approval.decision", "status": "Denied", "payload": {}, "issue": true },
    { "name": "blocked status", "kind": "tool.call", "status": "blocked", "payload": {}, "issue": true },
    { "name": "rejected status is a refusal like denied", "kind": "approval.decision", "status": "rejected", "payload": {}, "issue": true },
    { "name": "approved decision", "kind": "approval.decision", "status": "approved", "payload": {}, "issue": false },
    { "name": "pending request", "kind": "approval.request", "status": "pending", "payload": {}, "issue": false },
    { "name": "cancelled is not a failure", "kind": "tool.result", "status": "cancelled", "payload": {}, "issue": false },
    { "name": "warning status", "kind": "adapter.diagnostic", "status": "warning", "payload": {}, "issue": false },

    { "name": "kind segment error", "kind": "tool.error", "status": "ok", "payload": {}, "issue": true },
    { "name": "kind segment failed after underscore", "kind": "tool.execution_failed", "status": "ok", "payload": {}, "issue": true },
    { "name": "kind segment failed", "kind": "turn.failed", "status": "", "payload": {}, "issue": true },
    { "name": "kind segment failure", "kind": "agent.failure", "status": "", "payload": {}, "issue": true },
    { "name": "kind in upper case", "kind": "Model.ERROR", "status": "", "payload": {}, "issue": true },
    { "name": "spawn failure", "kind": "process.spawn_failed", "status": "ok", "payload": {}, "issue": true },
    { "name": "failover only contains the letters", "kind": "tool.failover", "status": "ok", "payload": {}, "issue": false },
    { "name": "failsafe only contains the letters", "kind": "agent.failsafe_check", "status": "ok", "payload": {}, "issue": false },
    { "name": "error_rate is a measurement", "kind": "metrics.errorrate", "status": "ok", "payload": {}, "issue": false },
    { "name": "stderr is output, not an error", "kind": "process.stderr", "status": "", "payload": { "text": "error: build failed" }, "issue": false },
    { "name": "terror contains error", "kind": "game.terrors", "status": "", "payload": {}, "issue": false },

    { "name": "top-level is_error without a status", "kind": "tool.result", "status": "", "payload": { "is_error": true }, "issue": true },
    { "name": "top-level isError without a status", "kind": "tool.result", "status": "", "payload": { "isError": true }, "issue": true },
    { "name": "top-level error text without a status", "kind": "tool.result", "status": "", "payload": { "tool": "deploy", "error": "permission denied" }, "issue": true },
    { "name": "top-level error object without a status", "kind": "model.response", "status": "", "payload": { "error": { "message": "quota" } }, "issue": true },
    { "name": "top-level non-zero exit code without a status", "kind": "tool.result", "status": "", "payload": { "tool": "test", "exit_code": 2 }, "issue": true },
    { "name": "top-level exitCode without a status", "kind": "tool.result", "status": "  ", "payload": { "exitCode": 1 }, "issue": true },
    { "name": "top-level failing payload status without an event status", "kind": "tool.result", "status": "", "payload": { "status": "failed" }, "issue": true },
    { "name": "zero exit code", "kind": "tool.result", "status": "", "payload": { "exit_code": 0 }, "issue": false },
    { "name": "null exit code", "kind": "tool.result", "status": "", "payload": { "exit_code": null }, "issue": false },
    { "name": "empty error", "kind": "tool.result", "status": "", "payload": { "error": "", "is_error": false }, "issue": false },
    { "name": "null error", "kind": "tool.result", "status": "", "payload": { "error": null }, "issue": false },
    { "name": "empty error list", "kind": "tool.result", "status": "", "payload": { "error": [], "errors": 3 }, "issue": false },
    { "name": "nested failure fields are data", "kind": "tool.call", "status": "", "payload": { "input": { "is_error": true, "exit_code": 1, "error": "x" } }, "issue": false },
    { "name": "prose about failure", "kind": "agent.message", "status": "", "payload": { "text": "the build failed with an error" }, "issue": false },
    { "name": "a recorded status outranks the payload", "kind": "tool.result", "status": "ok", "payload": { "is_error": true, "exit_code": 3, "error": "boom" }, "issue": false },
    { "name": "payload that is not an object", "kind": "tool.result", "status": "", "payload": "error", "issue": false },

    { "name": "native is_error with ok status", "kind": "tool.result", "status": "ok", "payload": { "native": { "type": "result", "is_error": true } }, "issue": true },
    { "name": "native item exit code", "kind": "tool.result", "status": "ok", "payload": { "native": { "type": "item.completed", "item": { "exit_code": 2 } } }, "issue": true },
    { "name": "native rejected status", "kind": "tool.result", "status": "ok", "payload": { "native": { "type": "tool_result", "status": "rejected" } }, "issue": true },
    { "name": "native healthy", "kind": "tool.result", "status": "ok", "payload": { "native": { "type": "item.completed", "item": { "exit_code": 0, "status": "completed" } } }, "issue": false },
    { "name": "native arguments are data", "kind": "tool.call", "status": "ok", "payload": { "native": { "type": "tool_use", "input": { "status": "failed", "is_error": true } } }, "issue": false },
    { "name": "native block named by correlation id, healthy", "kind": "tool.result", "status": "ok", "correlation_id": "t1", "payload": { "native": { "type": "user", "message": { "content": [ { "type": "tool_result", "tool_use_id": "t1" }, { "type": "tool_result", "tool_use_id": "t2", "is_error": true } ] } } }, "issue": false },
    { "name": "native block named by correlation id, failed", "kind": "tool.result", "status": "ok", "correlation_id": "t2", "payload": { "native": { "type": "user", "message": { "content": [ { "type": "tool_result", "tool_use_id": "t1" }, { "type": "tool_result", "tool_use_id": "t2", "is_error": true } ] } } }, "issue": true }
  ]
}
